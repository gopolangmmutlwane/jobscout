ANTHROPIC_API_KEY=
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
TELEGRAM_BOT_TOKEN=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Leave blank to use local SQLite. Later: a hosted Postgres URL.
DATABASE_URL=
# Triage web page (python -m jobscout.web). The app refuses to start while these are empty or "change-me".
# Use a PIN of 6+ digits. Secret key: python -c "import secrets; print(secrets.token_hex(32))"
WEB_PIN=change-me
WEB_SECRET_KEY=change-me
WEB_PORT=8765
# Address the phone uses to reach the page, e.g. http://192.168.1.20:8765. When set, each ad in the
# email digest gets a "skip / keep / applied" link. Leave blank to keep the email as it is.
WEB_BASE_URL=
